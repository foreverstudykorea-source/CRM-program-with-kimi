generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  FINANCE
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum MessageType {
  GENERAL
  ATTENDANCE
  PAYMENT
}

enum ChargeStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PaymentMethod {
  CASH
  CARD
  CLICK
  PAYME
  BANK_TRANSFER
}

enum StudentStatus {
  ACTIVE
  FROZEN
  COMPLETED
  PROSPECT
}

enum StudentPaymentStatus {
  PAID
  DEBT
  UNPAID
  UNKNOWN
}

model User {
  id                 String         @id @default(cuid())
  fullName           String
  phone              String         @unique
  passwordHash       String
  role               Role
  isActive           Boolean        @default(true)
  avatarUrl          String?
  jobTitle           String?
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(6)
  teachingGroups     Group[]
  groupMemberships   GroupStudent[]
  attendance         Attendance[]
  markedAttendance   Attendance[]   @relation("AttendanceMarkedBy")
  homework           Homework[]
  sentMessages       Message[]      @relation("MessageSender")
  receivedMessages   Message[]      @relation("MessageRecipient")
  charges            Charge[]
  payments           Payment[]
  receivedPayments   Payment[]      @relation("PaymentReceivedBy")
  auditLogs          AuditLog[]
  sessions           Session[]
  studentProfile     StudentProfile?
  supportSignups     SupportSignup[]

  @@index([role, isActive])
  @@index([fullName])
}

model StudentProfile {
  id             String               @id @default(cuid())
  userId         String               @unique
  sourceRow      Int?                 @unique
  status         StudentStatus        @default(PROSPECT)
  courseType     String?
  teacherName    String?
  scheduleText   String?
  timeText       String?
  trialDate      DateTime?            @db.Date
  startDate      DateTime?            @db.Date
  startDateText  String?
  paymentStatus  StudentPaymentStatus @default(UNKNOWN)
  paymentTiming  String?
  debtAmount     Int?
  salesManager   String?
  notes          String?              @db.Text
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([paymentStatus])
  @@index([salesManager])
  @@index([teacherName, scheduleText, timeText])
}

model Course {
  id           String   @id @default(cuid())
  name         String
  monthlyPrice Int
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  groups       Group[]

  @@index([name])
}

model Group {
  id        String      @id @default(cuid())
  name      String
  courseId  String
  teacherId String
  weekDays  WeekDay[]
  startTime String
  endTime   String?
  room      String?
  startDate DateTime    @db.Date
  status    GroupStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @db.Timestamptz(6)
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacher   User        @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  students  GroupStudent[]
  lessons   Lesson[]
  homework  Homework[]
  messages  Message[]
  charges   Charge[]

  @@index([courseId])
  @@index([teacherId, status])
  @@index([status, startDate])
}

model GroupStudent {
  groupId   String
  studentId String
  joinedAt  DateTime   @default(now()) @db.Timestamptz(6)
  leftAt    DateTime?  @db.Timestamptz(6)
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([groupId, studentId])
  @@index([studentId, leftAt])
  @@index([groupId, leftAt])
}

model Lesson {
  id         String       @id @default(cuid())
  groupId    String
  date       DateTime     @db.Date
  topic      String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendance Attendance[]
  supportSignups SupportSignup[]

  @@unique([groupId, date])
  @@index([date])
  @@index([groupId, date])
}

model SupportSignup {
  id        String   @id @default(cuid())
  lessonId  String
  studentId String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([lessonId])
  @@index([studentId, createdAt])
}

model Attendance {
  id         String           @id @default(cuid())
  lessonId   String
  studentId  String
  status     AttendanceStatus
  note       String?
  markedById String
  markedAt   DateTime         @default(now()) @db.Timestamptz(6)
  lesson     Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy   User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([lessonId, studentId])
  @@index([studentId, status])
  @@index([markedById])
  @@index([status])
}

model Homework {
  id            String   @id @default(cuid())
  groupId       String
  title         String
  description   String
  attachmentUrl String?
  dueDate       DateTime @db.Date
  createdById   String
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([groupId, dueDate])
  @@index([createdById])
  @@index([dueDate])
}

model Message {
  id          String      @id @default(cuid())
  senderId    String
  recipientId String
  groupId     String?
  type        MessageType @default(GENERAL)
  body        String      @db.Text
  readAt      DateTime?   @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  sender      User        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient   User        @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  group       Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([senderId, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@index([groupId])
  @@index([type, createdAt])
}

model Charge {
  id        String       @id @default(cuid())
  studentId String
  groupId   String
  month     DateTime     @db.Date
  amount    Int
  discount  Int          @default(0)
  status    ChargeStatus @default(UNPAID)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)
  student   User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     Group        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  payments  Payment[]

  @@unique([studentId, groupId, month])
  @@index([studentId, status, month])
  @@index([groupId, month])
  @@index([month, status])
}

model Payment {
  id           String        @id @default(cuid())
  studentId    String
  chargeId     String?
  amount       Int
  method       PaymentMethod
  paidAt       DateTime      @db.Timestamptz(6)
  receivedById String
  note         String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  student      User          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  charge       Charge?       @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  receivedBy   User          @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)

  @@index([studentId, paidAt])
  @@index([chargeId])
  @@index([receivedById])
  @@index([paidAt, method])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id             String   @id @default(cuid())
  identifierHash String
  ipHash         String
  wasSuccessful  Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifierHash, wasSuccessful, createdAt])
  @@index([ipHash, wasSuccessful, createdAt])
  @@index([createdAt])
}
